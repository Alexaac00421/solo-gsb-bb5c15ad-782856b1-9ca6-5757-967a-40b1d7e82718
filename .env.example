# Copy to .env to override defaults
# Web UI / API listen port (host side)
APP_PORT=3000

# PostgreSQL (container port is published on POSTGRES_PORT)
POSTGRES_USER=deleg
POSTGRES_PASSWORD=deleg
POSTGRES_DB=delegation
POSTGRES_PORT=55432

# Security
JWT_SECRET=change-me-in-production

# Initial administrator (seeded on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
