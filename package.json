    "test:concurrency": "node test/concurrency.test.js",
    "test": "npm run test:cidr && npm run test:e2e && npm run test:concurrency"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "embedded-postgres": "^10.20.0-beta.6"
  }
