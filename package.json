{
  "name": "prefix-delegation",
  "version": "1.0.0",
  "description": "Intranet IPv4/IPv6 prefix delegation web console (Node.js + PostgreSQL)",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test:cidr": "node test/cidr.test.js",
